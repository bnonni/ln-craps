{
  "name": "ln-craps",
  "version": "0.1.0",
  "private": true,
  "description": "Provably fair Bitcoin Lightning Network craps",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
