# Bun loads .env automatically. Copy this file to .env and change the values.

PORT=3000
DATABASE_PATH=data/ln-craps.sqlite

# "fake" moves no real money and turns on the /api/dev routes. "lnd" connects to a real node.
# "bark" connects to a barkd wallet (Lightning over Ark).
LN_BACKEND=fake
LND_REST_URL=https://127.0.0.1:8080
LND_MACAROON_PATH=/path/to/craps.macaroon
LND_TLS_CERT_PATH=/path/to/tls.cert

# barkd also uses port 3000. With LN_BACKEND=bark, set PORT to a different port, for example 8787.
# Get the token with: barkd --datadir <datadir> secret show
BARKD_URL=http://127.0.0.1:3000
BARKD_TOKEN=

# Table limits (sats, for each flat bet)
MIN_BET=1
MAX_BET=100000

# Deposits (sats)
MIN_DEPOSIT=1
MAX_DEPOSIT=1000000
DEPOSIT_EXPIRY_SECONDS=600

# Withdrawals (sats). Fee reserve = max(WITHDRAWAL_FEE_BASE, ceil(amount * WITHDRAWAL_FEE_PPM / 1000000)).
# The Bark signet server charges max(20 sats, up to 5000 ppm). With LN_BACKEND=bark, set WITHDRAWAL_FEE_BASE=20.
MAX_WITHDRAWAL=1000000
WITHDRAWAL_FEE_BASE=10
WITHDRAWAL_FEE_PPM=5000
WITHDRAWAL_TIMEOUT_SECONDS=60

INVOICE_MEMO=ln-craps deposit
